generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Auth
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("CUSTOMER") // CUSTOMER or ADMIN
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Ordering System (Legacy/Preserved)
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // e.g. GM-1004
  userId        String?     // null for guest checkout
  user          User?       @relation(fields: [userId], references: [id])
  
  // Customer Details (for guests)
  customerName  String
  customerEmail String
  customerPhone String
  
  // Order Details
  status        String      @default("PENDING") // PENDING, CONFIRMED, PREPARING, READY, COMPLETED, CANCELLED
  type          String      @default("PICKUP") // PICKUP, DINE_IN
  pickupTime    DateTime?
  specialInstructions String?
  
  // Pricing (in cents)
  subtotal      Int
  tax           Int
  total         Int
  
  items         OrderItem[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Snapshot of product at time of order
  productId   String
  productName String
  variantName String?
  price       Int         // Price per unit in cents
  quantity    Int
  
  // Selected modifiers (stored as JSON to avoid complex joins for historical data)
  // e.g. [{"group": "Choice of Sides", "option": "Greek Salad", "priceDelta": 150}]
  modifiers   String?     
  
  specialInstructions String?
}

// System Settings
model RestaurantSetting {
  key         String      @id
  value       String
  updatedAt   DateTime    @updatedAt
}

// CMS Models
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  displayOrder Int      @default(0)
  isHidden    Boolean   @default(false)
  isArchived  Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  shortDescription String?
  fullDescription String?
  basePrice       Int       // Price in cents
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  isAvailable     Boolean   @default(true)
  isSoldOut       Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  displayOrder    Int       @default(0)
  menuInfoGroups  String?   // JSON for sides, sizes, combos
  
  collections     MenuCollectionProduct[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  altText     String?
  displayOrder Int     @default(0)
}

model MenuCollection {
  id          String    @id @default(cuid())
  name        String    // e.g. "Signature Dishes", "Best Sellers"
  slug        String    @unique
  subtitle    String?
  image       String?
  layout      String    @default("GRID") // GRID, LIST, CAROUSEL
  isPublished Boolean   @default(false)
  isArchived  Boolean   @default(false)
  showOnHome  Boolean   @default(false)
  showOnMenu  Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  
  products    MenuCollectionProduct[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MenuCollectionProduct {
  id           String         @id @default(cuid())
  collectionId String
  collection   MenuCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int            @default(0)

  @@unique([collectionId, productId])
}

model HomepageSection {
  id              String   @id @default(cuid())
  identifier      String   @unique // e.g. "HERO", "SERVICES", "CATERING"
  heading         String?
  subheading      String?
  content         String?
  primaryImage    String?
  secondaryImage  String?
  buttonText      String?
  buttonLink      String?
  
  isHidden        Boolean  @default(false)
  
  // For sections that feature specific products manually
  productSelections HomepageProductSelection[]
  
  // Or link to a whole collection
  collectionId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HomepageProductSelection {
  id           String          @id @default(cuid())
  sectionId    String
  section      HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId    String
  displayOrder Int             @default(0)
}

model MediaAsset {
  id          String   @id @default(cuid())
  url         String
  publicId    String?  @unique // For Cloudinary/S3 deletion
  altText     String?
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  
  createdAt   DateTime @default(now())
}
